<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="appName">VS2000 Writers</string>
    <!-- ?app=writers marks the tab as the Writers app. The site then keeps it
         on the writer portal: signing out, an expired session or a stray link
         to the office login all land on /writer/login, never on the office
         role picker (which has no Writer role). The site also recognises the
         app by its android-app:// referrer, so phones on older builds are
         covered too. -->
    <string name="launchUrl">https://vs2000smartportal.com/writer/login?app=writers</string>
    <string name="hostName">vs2000smartportal.com</string>
</resources>
